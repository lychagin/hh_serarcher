# uid:gid, от которых compose запускает контейнер. Обязаны совпадать с
# владельцем ./data на хосте: bind-mount подменяет каталог образа хостовым
# ВМЕСТЕ с владельцем, поэтому chown внутри Dockerfile до него не доезжает.
# При несовпадении первая же команда отвечает одной строкой вида
#   нет доступа к каталогу данных /data/state (база hh.db): [Errno 13]
#   Permission denied: ... процесс работает от uid=10001 gid=10001, а /data
#   принадлежит uid=1000 gid=1000 ... приведите HH_UID/HH_GID в .env ...
# — то есть называет и свой uid, и владельца тома. Заполняется один раз:
#   printf 'HH_UID=%s\nHH_GID=%s\n' "$(id -u)" "$(id -g)" >> .env
# и после правки нужен `docker compose up -d --force-recreate`: `user:`
# задаётся при создании контейнера, а не при перезапуске.
HH_UID=1000
HH_GID=1000

# Понадобится начиная с TelegramSink, в первой версии не используется.
# HH_TELEGRAM_TOKEN=
# HH_TELEGRAM_CHAT_ID=
