#!/bin/sh
# Ворота проекта: четыре проверки по порядку, падение на первой красной.
#
# Состав ворот живёт здесь и больше нигде: CI зовёт этот скрипт, а CLAUDE.md
# перечисляет его шаги под сторожем tests/test_claude_md.py. До этого скрипта
# состав существовал в README.md и в .github/workflows/ci.yml по отдельности,
# в разном порядке, и класс отказа «прогнал три из четырёх и сказал зелено»
# не был перекрыт ничем.
#
# `uv sync` сюда не входит: локально окружение уже есть, а в CI это отдельный
# шаг с кэшем. Это ворота, а не установщик.
#
# Контрактные тесты (метка `network`) в ворота не входят: они ходят в живой
# hh.ru. Их запускают вручную — `uv run pytest -m network`.
set -eu

cd "$(dirname "$0")"

echo "== Линтер =="
uv run ruff check .

echo "== Форматирование =="
uv run ruff format --check .

echo "== Типы =="
uv run mypy hh_search tests

echo "== Тесты =="
uv run pytest -q

echo "== Ворота зелёные =="
